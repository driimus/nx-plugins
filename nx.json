{
  "defaultBase": "main",
  "workspaceLayout": {
    "appsDir": "packages",
    "libsDir": "packages"
  },
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "plugins": [
    {
      "plugin": "@nx/vitest",
      "include": ["packages/*-e2e/**/*"],
      "options": {
        "testTargetName": "e2e",
        "testMode": "run"
      }
    },
    {
      "plugin": "@nx/vitest",
      "exclude": ["packages/*-e2e/**/*"],
      "options": {
        "testTargetName": "test",
        "testMode": "run"
      }
    }
  ],
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "e2e": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/nx.json"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/vitest.config.*",
      "!{projectRoot}/src/test-setup.[jt]s"
    ]
  },
  "nxCloudAccessToken": "ODljYzhlMjYtMmIzYS00OWUwLWE3NTItZWNlNDE0MTc5ZDlkfHJlYWQ=",
  "release": {
    "projects": ["packages/*", "!packages/*-e2e"],
    "version": {
      "conventionalCommits": true,
      "preserveLocalDependencyProtocols": false,
      "manifestRootsToUpdate": ["dist/{projectRoot}"]
    },
    "changelog": {
      "workspaceChangelog": {
        "file": false
      },
      "projectChangelogs": {
        "file": false,
        "createRelease": "github"
      }
    }
  },
  "analytics": false
}
